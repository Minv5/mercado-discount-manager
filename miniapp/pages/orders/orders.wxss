.search-box {
  margin-bottom: 20rpx;
}

.search-input {
  background: #18201C;
  color: #F6F3EA;
  border: 1rpx solid #4E472F;
  border-radius: 36rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.filter-tabs {
  display: flex;
  background: #1C231F;
  border: 1rpx solid #4E472F;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #C8C3B7;
  border-radius: 10rpx;
}

.filter-item.active {
  background: #2F6B3F;
  color: #F6F3EA;
  font-weight: 500;
  border: 1rpx solid #6E5D2A;
}

/* 订单卡片 */
.order-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #2B352E;
  padding-bottom: 12rpx;
}

.order-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.store-badge {
  background: #203A2B;
  color: #4CAF50;
  border: 1rpx solid #2F6B3F;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.site-tag {
  background: #2D2619;
  color: #D4AF37;
  border: 1rpx solid #6E5D2A;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.order-id-mono {
  font-size: 22rpx;
  font-family: monospace;
  color: #C8C3B7;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.order-body {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.order-thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 8rpx;
  background: #2D3A30;
  border: 1rpx solid #4E472F;
  flex-shrink: 0;
}

.order-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.order-title {
  font-size: 26rpx;
  color: #F6F3EA;
  line-height: 1.3;
}

.order-bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #D4AF37;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #2B352E;
  padding-top: 14rpx;
  font-size: 22rpx;
  color: #777266;
  gap: 12rpx;
}

.tracking-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #18281E;
  border: 1rpx solid #2F6B3F;
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #4CAF50;
}

.tracking-mono {
  font-family: monospace;
}

.buyer-city {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #C8C3B7;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #777266;
}

/* 订单全景抽屉 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.drawer-content {
  background: #1C231F;
  border-top: 1rpx solid #4E472F;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  padding: 30rpx 28rpx;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #2B352E;
}

.drawer-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.drawer-badge {
  background: #203A2B;
  color: #4CAF50;
  border: 1rpx solid #2F6B3F;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.drawer-status {
  font-size: 26rpx;
  font-weight: bold;
}

.close-btn {
  font-size: 36rpx;
  color: #C8C3B7;
  padding: 10rpx;
}

.drawer-scroll {
  flex: 1;
  max-height: 65vh;
  margin-top: 20rpx;
}

.section-box {
  background: #171B19;
  border: 1rpx solid #353022;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.box-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #D4AF37;
  margin-bottom: 16rpx;
  border-bottom: 1rpx dashed #2B352E;
  padding-bottom: 10rpx;
}

.box-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 10rpx 0;
  font-size: 24rpx;
}

.box-row .k {
  color: #C8C3B7;
  flex-shrink: 0;
  width: 170rpx;
}

.box-row .v {
  color: #F6F3EA;
  word-break: break-all;
}

.v-btn-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.v-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex: 1;
}

.mini-copy-btn {
  background: #2D2619;
  color: #D4AF37;
  border: 1rpx solid #6E5D2A;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  line-height: 1.4;
  margin: 0;
}

.product-item-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #202820;
}

.product-item-row:last-child {
  border-bottom: none;
}

.p-thumb {
  width: 90rpx;
  height: 90rpx;
  border-radius: 8rpx;
  background: #202820;
  border: 1rpx solid #353022;
  flex-shrink: 0;
}

.p-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.p-title {
  font-size: 24rpx;
  color: #F6F3EA;
  line-height: 1.3;
}

.p-meta {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
}

.p-price {
  font-size: 24rpx;
  font-weight: 500;
}

.drawer-footer {
  margin-top: 20rpx;
  padding-top: 10rpx;
}

.btn-primary {
  background: #2F6B3F;
  color: #F6F3EA;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: 1rpx solid #6E5D2A;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #334036;
  border-top-color: #4CAF50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #8C877A;
}
