.search-box {
  margin-bottom: 20rpx;
}

.search-input {
  background: #18201C;
  color: #F6F3EA;
  border: 1rpx solid #4E472F;
  border-radius: 36rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.filter-tabs {
  display: flex;
  background: #1C231F;
  border: 1rpx solid #4E472F;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #C8C3B7;
  border-radius: 10rpx;
}

.filter-item.active {
  background: #2F6B3F;
  color: #F6F3EA;
  font-weight: 500;
  border: 1rpx solid #6E5D2A;
}

/* 订单卡片 */
.order-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #2B352E;
  padding-bottom: 12rpx;
}

.order-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.store-badge {
  background: #203A2B;
  color: #4CAF50;
  border: 1rpx solid #2F6B3F;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.site-tag {
  background: #2D2619;
  color: #D4AF37;
  border: 1rpx solid #6E5D2A;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.sla-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.sla-green {
  background: rgba(52, 211, 153, 0.15);
  color: #34D399;
  border: 1rpx solid rgba(52, 211, 153, 0.4);
}

.sla-yellow {
  background: rgba(251, 191, 36, 0.15);
  color: #FBBF24;
  border: 1rpx solid rgba(251, 191, 36, 0.4);
}

.sla-red {
  background: rgba(239, 68, 68, 0.18);
  color: #EF4444;
  border: 1rpx solid rgba(239, 68, 68, 0.45);
}

.sla-overdue {
  background: rgba(239, 68, 68, 0.22);
  color: #F87171;
  border: 1rpx solid rgba(239, 68, 68, 0.5);
}

.buyer-nickname-top {
  font-size: 22rpx;
  color: #F6F3EA;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
}

.order-id-mono {
  font-size: 22rpx;
  font-family: monospace;
  color: #C8C3B7;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.order-body {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.order-thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 8rpx;
  background: #2D3A30;
  border: 1rpx solid #4E472F;
  flex-shrink: 0;
}

.order-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.order-title {
  font-size: 26rpx;
  color: #E6E2D8;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.order-bottom-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.order-paid-amount {
  font-size: 24rpx;
  font-weight: bold;
  color: #34D399;
}

.order-qty-pill {
  font-size: 20rpx;
  font-weight: bold;
  color: #FCD34D;
  background: rgba(245, 158, 11, 0.15);
  border: 1rpx solid rgba(245, 158, 11, 0.3);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.order-sku-chip {
  font-size: 20rpx;
  font-weight: 500;
  color: #D4AF37;
  background: rgba(212, 175, 55, 0.12);
  border: 1rpx solid rgba(212, 175, 55, 0.35);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.order-single-chip {
  font-size: 20rpx;
  color: #A8A29E;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #777266;
}

/* 订单全景抽屉 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.drawer-content {
  background: #1C231F;
  border-top: 1rpx solid #4E472F;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  padding: 30rpx 28rpx;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #2B352E;
}

.drawer-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.drawer-badge {
  background: #203A2B;
  color: #4CAF50;
  border: 1rpx solid #2F6B3F;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.drawer-status {
  font-size: 26rpx;
  font-weight: bold;
}

.close-btn {
  font-size: 36rpx;
  color: #C8C3B7;
  padding: 10rpx;
}

.drawer-scroll {
  flex: 1;
  max-height: 65vh;
  margin-top: 20rpx;
}

.section-box {
  background: #171B19;
  border: 1rpx solid #353022;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.box-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #D4AF37;
  margin-bottom: 16rpx;
  border-bottom: 1rpx dashed #2B352E;
  padding-bottom: 10rpx;
}

.box-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 10rpx 0;
  font-size: 24rpx;
}

.box-row .k {
  color: #C8C3B7;
  flex-shrink: 0;
  width: 170rpx;
}

.box-row .v {
  color: #F6F3EA;
  word-break: break-all;
}

/* 费用收支与利润结算 3格指标卡 (对齐桌面端) */
.fin-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.fin-box {
  background: #141A17;
  border: 1rpx solid #2B3830;
  border-radius: 10rpx;
  padding: 12rpx 10rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.fin-box-highlight {
  background: #1A211D;
  border: 1rpx solid #4E472F;
}

.fin-lbl {
  font-size: 20rpx;
  color: #A8A29E;
  white-space: nowrap;
}

.fin-val {
  font-size: 22rpx;
  font-weight: bold;
  word-break: break-all;
}

.fin-footer-meta {
  font-size: 20rpx;
  color: #8C877A;
  border-top: 1rpx dashed #2B352E;
  padding-top: 10rpx;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* 抽屉内分区头部横条 */
.box-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  border-bottom: 1rpx dashed #2B352E;
  padding-bottom: 10rpx;
}

.box-title-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #D4AF37;
}

.print-badge {
  font-size: 20rpx;
  font-weight: 500;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.print-done {
  background: rgba(16, 185, 129, 0.16);
  color: #34d399;
  border: 1rpx solid rgba(16, 185, 129, 0.35);
}

.print-pending {
  background: rgba(245, 158, 11, 0.16);
  color: #fbbf24;
  border: 1rpx solid rgba(245, 158, 11, 0.35);
}

.box-meta-line {
  font-size: 22rpx;
  color: #C8C3B7;
  margin-bottom: 12rpx;
}

.btn-contact-buyer {
  background: #1F3A2E;
  color: #A7F3D0;
  border: 1rpx solid #059669;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  line-height: 1.4;
  margin: 0;
}

/* 堆叠式地址行 */
.box-row-stacked {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 10rpx 0;
}

.k-copy-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.address-text {
  font-size: 24rpx;
  color: #F6F3EA;
  line-height: 1.4;
  background: #121714;
  padding: 12rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid #28352C;
  word-break: break-all;
}

/* 商品卡片内部标签行 */
.p-chips-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.p-item-id {
  font-size: 20rpx;
  color: #93C5FD;
  background: rgba(59, 130, 246, 0.12);
  border: 1rpx solid rgba(59, 130, 246, 0.35);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.p-sku {
  font-size: 20rpx;
  color: #D4AF37;
  background: rgba(212, 175, 55, 0.12);
  border: 1rpx solid rgba(212, 175, 55, 0.35);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.p-single {
  font-size: 20rpx;
  color: #A8A29E;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.p-price-qty-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 6rpx;
}

.text-purple {
  color: #818CF8;
}

.product-item-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #202820;
}

.product-item-row:last-child {
  border-bottom: none;
}

.p-thumb {
  width: 90rpx;
  height: 90rpx;
  border-radius: 8rpx;
  background: #202820;
  border: 1rpx solid #353022;
  flex-shrink: 0;
}

.p-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.p-title {
  font-size: 24rpx;
  color: #F6F3EA;
  line-height: 1.3;
}

.p-meta {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
}

.p-price {
  font-size: 24rpx;
  font-weight: 500;
}

.drawer-footer {
  margin-top: 20rpx;
  padding-top: 10rpx;
}

.btn-primary {
  background: #2F6B3F;
  color: #F6F3EA;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: 1rpx solid #6E5D2A;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #334036;
  border-top-color: #4CAF50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #8C877A;
}
