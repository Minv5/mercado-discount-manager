.search-box {
  margin-bottom: 20rpx;
}

.search-input {
  background: #18201C;
  color: #F6F3EA;
  border: 1rpx solid #4E472F;
  border-radius: 36rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.filter-tabs {
  display: flex;
  background: #1C231F;
  border: 1rpx solid #4E472F;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #C8C3B7;
  border-radius: 10rpx;
}

.filter-item.active {
  background: #2F6B3F;
  color: #F6F3EA;
  font-weight: 500;
  border: 1rpx solid #6E5D2A;
}

/* 订单卡片 */
.order-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #2B352E;
  padding-bottom: 12rpx;
}

.order-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.store-badge {
  background: #203A2B;
  color: #4CAF50;
  border: 1rpx solid #2F6B3F;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.site-tag {
  background: #2D2619;
  color: #D4AF37;
  border: 1rpx solid #6E5D2A;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.order-id-mono {
  font-size: 22rpx;
  font-family: monospace;
  color: #C8C3B7;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.order-body {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.order-thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 8rpx;
  background: #2D3A30;
  border: 1rpx solid #4E472F;
  flex-shrink: 0;
}

.order-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.order-title {
  font-size: 26rpx;
  color: #F6F3EA;
  line-height: 1.3;
}

.order-bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #D4AF37;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #2B352E;
  padding-top: 14rpx;
  font-size: 22rpx;
  color: #777266;
}

.buyer-city {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #C8C3B7;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #777266;
}
