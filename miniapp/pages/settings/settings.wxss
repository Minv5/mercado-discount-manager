.profile-card {
  padding: 30rpx 24rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  background: #203A2B;
  border: 1rpx solid #2F6B3F;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
}

.profile-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.profile-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #F6F3EA;
}

.profile-appid {
  font-size: 22rpx;
  font-family: monospace;
  color: #D4AF37;
}

/* 店铺列表 */
.store-list {
  display: flex;
  flex-direction: column;
}

.store-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #2B352E;
}

.store-row:last-child {
  border-bottom: none;
}

.store-row-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.store-icon {
  font-size: 32rpx;
}

.store-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #F6F3EA;
}

.store-sub {
  font-size: 22rpx;
  color: #777266;
}

.status-online {
  font-size: 24rpx;
  color: #4CAF50;
  font-weight: 500;
}

/* 设置项 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.setting-info {
  flex: 1;
  padding-right: 20rpx;
}

.setting-label {
  display: block;
  font-size: 28rpx;
  color: #F6F3EA;
  margin-bottom: 4rpx;
}

.setting-desc {
  display: block;
  font-size: 22rpx;
  color: #C8C3B7;
}

/* 信息条目 */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #2B352E;
  font-size: 26rpx;
}

.info-label {
  color: #C8C3B7;
}

.info-val {
  color: #D4AF37;
  font-weight: 500;
}

.action-wrap {
  margin-top: 30rpx;
  margin-bottom: 40rpx;
}

.clear-btn {
  background: #2D1717;
  color: #EF5350;
  border: 1rpx solid #6E2A2A;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.test-btn {
  background: #203A2B;
  color: #D4AF37;
  border: 1rpx solid #4E472F;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 36rpx;
  padding: 12rpx 0;
  text-align: center;
}

.badge-gold {
  background: #3B331A;
  color: #D4AF37;
  border: 1rpx solid #6E5C24;
}
