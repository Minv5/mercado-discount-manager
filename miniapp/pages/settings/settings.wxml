<view class="container">
  <!-- 用户与AppID卡片 -->
  <view class="card profile-card">
    <view class="profile-header">
      <view class="avatar">🏬</view>
      <view class="profile-meta">
        <text class="profile-title">美客多移动工作台</text>
        <text class="profile-appid text-muted">小程序 AppID: {{appid}}</text>
      </view>
    </view>
  </view>

  <!-- 云端安全同步网关 -->
  <view class="card">
    <view class="section-title">
      <text>🌐 云端安全同步网关</text>
      <text class="badge {{gatewayOnline ? 'badge-green' : 'badge-gold'}}">{{gatewayOnline ? '已连接 (在线)' : '检查中'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">网关接入地址</text>
      <text class="info-val text-muted" style="font-size: 20rpx; word-break: break-all;">{{gatewayUrl}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">连接网络模式</text>
      <text class="info-val">4G/5G 移动公网直连 (Cloudflare)</text>
    </view>
    <view class="info-row">
      <text class="info-label">访问口令</text>
      <text class="badge {{tokenAccepted ? 'badge-green' : 'badge-gold'}}">{{tokenAccepted ? '已通过' : '未通过'}}</text>
    </view>
    <input class="token-input" password="true" value="{{gatewayToken}}" bindinput="onTokenInput" placeholder="粘贴电脑端「设置 → 消息推送」里复制的访问口令" />
    <view style="margin-top: 20rpx;">
      <button class="test-btn" bindtap="saveToken">保存并校验访问口令</button>
    </view>
    <view style="margin-top: 20rpx;">
      <button class="test-btn" bindtap="checkGateway">一键检测网关连接</button>
    </view>
  </view>

  <!-- 店铺授权概览 -->
  <view class="card">
    <view class="section-title">
      <text>🏪 已授权店铺列表</text>
      <text class="badge badge-green">3家全在线</text>
    </view>
    <view class="store-list">
      <view class="store-row" wx:for="{{stores}}" wx:key="id" wx:if="{{item.id}}">
        <view class="store-row-left">
          <text class="store-icon">📍</text>
          <view class="store-text">
            <text class="store-title">{{item.name}}</text>
            <text class="store-sub text-muted">店铺归属: {{item.alias}}</text>
          </view>
        </view>
        <text class="status-online">正常授权</text>
      </view>
    </view>
  </view>

  <!-- 消息推送联动设置 -->
  <view class="card">
    <view class="section-title">
      <text>🔔 微信服务通知联动</text>
    </view>
    <view class="setting-item">
      <view class="setting-info">
        <text class="setting-label">微信消息推送 (PushPlus)</text>
        <text class="setting-desc">收到新提问、私信或索赔时手机微信弹出服务通知</text>
      </view>
      <switch checked="{{pushEnabled}}" bindchange="togglePush" color="#2F6B3F" />
    </view>
  </view>

  <!-- 关于与技术信息 -->
  <view class="card">
    <view class="section-title">
      <text>ℹ️ 版本与技术信息</text>
    </view>
    <view class="info-row">
      <text class="info-label">小程序版本</text>
      <text class="info-val font-bold text-gold">{{miniappVersion}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">连接架构</text>
      <text class="info-val">美客多官方 API 直连</text>
    </view>
    <view class="info-row">
      <text class="info-label">双语互译引擎</text>
      <text class="info-val">拉美西语 / 巴西葡语智能直译</text>
    </view>
  </view>

  <view class="action-wrap">
    <button class="clear-btn" bindtap="clearStorage">清除本地缓存</button>
  </view>
</view>
