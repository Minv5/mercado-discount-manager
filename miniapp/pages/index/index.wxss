/* 顶部店铺切换器卡片：黑金沉稳风格 */
.store-selector-card {
  background: linear-gradient(135deg, #202922, #18201C);
  color: #F6F3EA;
  border: 1rpx solid #6E5D2A;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.4);
}

.store-info {
  margin-bottom: 16rpx;
}

.store-tag {
  font-size: 22rpx;
  color: #C8C3B7;
  margin-bottom: 6rpx;
}

.store-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #F6F3EA;
}

.arrow-down {
  font-size: 22rpx;
  color: #D4AF37;
  background: #2D2619;
  border: 1rpx solid #6E5D2A;
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
}

.store-sites {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.site-chip {
  background: #18201C;
  border: 1rpx solid #4E472F;
  color: #D4AF37;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

/* 销售概览网格 */
.stat-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #C8C3B7;
}

.refresh-time {
  font-size: 22rpx;
  font-weight: normal;
}

/* 待办中心列表 */
.todo-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #2B352E;
}

.todo-item:last-child {
  border-bottom: none;
}

.todo-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.todo-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border: 1rpx solid #4E472F;
}

.bg-orange { background: #2F2116; }
.bg-blue { background: #162432; }
.bg-red { background: #2D1616; }

.todo-info {
  display: flex;
  flex-direction: column;
}

.todo-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #F6F3EA;
}

.todo-desc {
  font-size: 22rpx;
  color: #C8C3B7;
  margin-top: 4rpx;
}

.todo-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  font-weight: 500;
  white-space: nowrap;
}

/* 快捷导航矩阵 */
.grid-nav {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 10rpx 0;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
}

.grid-icon {
  font-size: 46rpx;
  margin-bottom: 10rpx;
}

.grid-text {
  font-size: 24rpx;
  color: #E6E2D8;
}

.stat-sub-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #18201C;
  border: 1rpx solid #2B352E;
  margin-top: 16rpx;
  padding: 12rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.sub-arrow {
  color: #D4AF37;
  font-size: 20rpx;
  flex-shrink: 0;
}
