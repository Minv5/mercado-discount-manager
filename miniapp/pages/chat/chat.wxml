<view class="chat-container">
  <!-- 顶部商品/订单上下文信息卡片 -->
  <view class="context-card" wx:if="{{itemData.item_title || itemData.order_id}}">
    <image class="context-thumb" src="{{itemData.item_thumbnail}}" mode="aspectFill" />
    <view class="context-info">
      <!-- 索赔专属紧凑3行全量元数据整合排版 -->
      <block wx:if="{{chatType === 'claim'}}">
        <view class="context-top space-between">
          <view class="context-tags">
            <text class="store-tag" wx:if="{{itemData.store_name}}">{{itemData.store_name}}</text>
            <text class="site-tag" wx:if="{{itemData.site_id}}">{{itemData.site_id}}</text>
            <text class="item-id text-muted" wx:if="{{itemData.order_id}}">#{{itemData.order_id}}</text>
          </view>
          <text class="claim-top-amount" wx:if="{{itemData.amount}}">{{itemData.amount}}</text>
        </view>
        <text class="context-title ellipsis">{{itemData.item_title || '美客多售后索赔商品'}}</text>
        <view class="claim-meta-row">
          <text class="claim-pill {{itemData.status_class || 'badge-status-blue'}}">{{itemData.return_status_label || itemData.status_text || '待处理'}}</text>
          <text class="claim-pill {{itemData.rep_badge_class || (itemData.affects_reputation === 'affected' ? 'badge-rep-red' : 'badge-rep-green')}}">{{itemData.rep_badge_text || (itemData.affects_reputation === 'affected' ? '影响信誉: 是' : '影响信誉: 否')}}</text>
          <text class="claim-meta-reason ellipsis" wx:if="{{itemData.reason}}">原因: {{itemData.reason}}</text>
        </view>
      </block>

      <!-- 普通问答 / 售后私信排版 -->
      <block wx:else>
        <view class="context-top">
          <text class="store-tag">{{itemData.store_name}}</text>
          <text class="site-tag">{{itemData.site_id}}</text>
          <text class="item-id text-muted" wx:if="{{itemData.order_id}}">#{{itemData.order_id}}</text>
          <text class="item-id text-muted" wx:elif="{{itemData.item_id}}">{{itemData.item_id}}</text>
        </view>
        <text class="context-title ellipsis-2">{{itemData.item_title}}</text>
      </block>
    </view>
  </view>

  <!-- 对话消息气泡流 -->
  <scroll-view class="chat-scroll" scroll-y="true" scroll-into-view="{{scrollToView}}">
    <!-- 1. 售前咨询形态 -->
    <view class="qa-view" wx:if="{{chatType === 'question'}}">
      <!-- 买家提问气泡 -->
      <view class="chat-bubble buyer-bubble">
        <view class="bubble-header">
          <text class="sender-name">{{itemData.buyer_name}}</text>
          <text class="bubble-time text-muted">{{itemData.created_at}}</text>
        </view>
        <text class="bubble-text es-text" user-select="true" selectable="true">{{itemData.text_es}}</text>
        <view class="bubble-translation cn-text">
          <text class="trans-tag">中文参考：</text>
          <text class="trans-text-body" user-select="true" selectable="true">{{itemData.text_cn || '正在解析中文释义...'}}</text>
        </view>
      </view>

      <!-- 商家历史回复气泡 (严格对齐桌面端) -->
      <view class="chat-bubble seller-bubble" wx:if="{{itemData.has_answer && itemData.answer_es && !replied}}">
        <view class="bubble-header">
          <text class="sender-name">我 (商家已回复)</text>
          <text class="bubble-time text-muted">{{itemData.answer_time || itemData.created_at}}</text>
        </view>
        <text class="bubble-text es-text" user-select="true" selectable="true">{{itemData.answer_es}}</text>
        <view class="bubble-translation cn-text" wx:if="{{itemData.answer_cn}}">
          <text class="trans-tag">中文释义：</text>
          <text class="trans-text-body" user-select="true" selectable="true">{{itemData.answer_cn}}</text>
        </view>
      </view>

      <view class="reply-notice" wx:if="{{replied}}">
        <view class="chat-bubble seller-bubble">
          <view class="bubble-header">
            <text class="sender-name">我 (刚刚发送)</text>
            <text class="bubble-time text-muted">刚刚</text>
          </view>
          <text class="bubble-text es-text" user-select="true" selectable="true">{{repliedTextEs}}</text>
          <view class="bubble-translation cn-text">
            <text class="trans-tag">输入原文：</text>
            <text class="trans-text-body" user-select="true" selectable="true">{{repliedTextCn}}</text>
          </view>
        </view>
        <view class="sent-success-tip">✅ 回复已成功同步至美客多官方平台！</view>
      </view>
    </view>

    <!-- 2. 售后私信多轮形态 -->
    <view class="messages-view" wx:if="{{chatType === 'message'}}">
      <view class="msg-history">
        <block wx:if="{{itemData.history && itemData.history.length > 0}}">
          <block wx:for="{{itemData.history}}" wx:key="index">
            <view class="chat-bubble {{item.sender === 'buyer' ? 'buyer-bubble' : 'seller-bubble'}}">
              <view class="bubble-header">
                <text class="sender-name">{{item.sender === 'buyer' ? itemData.buyer_name : '我 (商家)'}}</text>
                <text class="bubble-time text-muted">{{item.time}}</text>
              </view>
              <text class="bubble-text es-text" user-select="true" selectable="true">{{item.text}}</text>
              <view class="bubble-translation cn-text" wx:if="{{item.text_cn}}">
                <text class="trans-tag">释义：</text>
                <text class="trans-text-body" user-select="true" selectable="true">{{item.text_cn}}</text>
              </view>
            </view>
          </block>
        </block>

        <!-- 初始空会话提示 -->
        <view class="empty-chat-tip" wx:elif="{{!replied}}">
          <text class="empty-chat-icon">💬</text>
          <text class="empty-chat-text">买家尚未主动发起咨询或暂无往来记录</text>
          <text class="empty-chat-sub">您可在下方直接输入中文，系统将自动双语转译为{{targetLangName}}并联系买家</text>
        </view>

        <view class="chat-bubble seller-bubble" wx:if="{{replied && (!itemData.history || itemData.history.length === 0)}}">
          <view class="bubble-header">
            <text class="sender-name">我 (刚刚发送)</text>
            <text class="bubble-time text-muted">刚刚</text>
          </view>
          <text class="bubble-text es-text" user-select="true" selectable="true">{{repliedTextEs}}</text>
          <view class="bubble-translation cn-text">
            <text class="trans-tag">输入原文：</text>
            <text class="trans-text-body" user-select="true" selectable="true">{{repliedTextCn}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 3. 索赔处理形态 -->
    <view class="claim-view" wx:if="{{chatType === 'claim'}}">
      <!-- 双方协商沟通历史流 -->
      <view class="claim-chat-section">
        <block wx:if="{{itemData.history && itemData.history.length > 0}}">
          <block wx:for="{{itemData.history}}" wx:key="index">
            <view class="chat-bubble {{item.sender === 'seller' ? 'seller-bubble' : (item.sender === 'mediator' ? 'mediator-bubble' : 'buyer-bubble')}}">
              <view class="bubble-header">
                <text class="sender-name">{{item.sender_name || (item.sender === 'seller' ? '我 (商家)' : (item.sender === 'mediator' ? '美客多调解员' : (itemData.buyer_name || '买家')))}}</text>
                <text class="bubble-time text-muted">{{item.time}}</text>
              </view>
              <text class="bubble-text es-text" user-select="true" selectable="true">{{item.text}}</text>
              <view class="bubble-translation cn-text" wx:if="{{item.text_cn}}">
                <text class="trans-tag">中文参考：</text>
                <text class="trans-text-body" user-select="true" selectable="true">{{item.text_cn}}</text>
              </view>
            </view>
          </block>
        </block>

        <!-- 无直接文本对话时的处理流程时间轴 -->
        <view class="claim-timeline-card" wx:else>
          <view class="timeline-title">📌 纠纷处理时间轴与当前状态</view>
          <view class="timeline-step step-done">
            <view class="step-dot active"></view>
            <view class="step-content">
              <text class="step-name">1. 买家申请售后</text>
              <text class="step-desc text-muted">买家已选择原因【{{itemData.reason}}】提交官方系统</text>
            </view>
          </view>
          <view class="timeline-step step-done">
            <view class="step-dot active"></view>
            <view class="step-content">
              <text class="step-name">2. 双方协商 / 退货核验</text>
              <text class="step-desc text-muted">当前进度：{{itemData.return_status_label || '官方介入协调中'}}</text>
            </view>
          </view>
          <view class="timeline-step">
            <view class="step-dot {{itemData.is_closed ? 'active' : ''}}"></view>
            <view class="step-content">
              <text class="step-name">3. 结案判定</text>
              <text class="step-desc text-muted">{{itemData.is_closed ? '此索赔已顺利结案' : '若协商达成退款或超时将由系统自动闭环'}}</text>
            </view>
          </view>
        </view>

        <!-- 刚刚发送的商家消息 -->
        <view class="chat-bubble seller-bubble" wx:if="{{replied && (!itemData.history || itemData.history.length === 0)}}">
          <view class="bubble-header">
            <text class="sender-name">我 (刚刚发送)</text>
            <text class="bubble-time text-muted">刚刚</text>
          </view>
          <text class="bubble-text es-text" user-select="true" selectable="true">{{repliedTextEs}}</text>
          <view class="bubble-translation cn-text">
            <text class="trans-tag">输入原文：</text>
            <text class="trans-text-body" user-select="true" selectable="true">{{repliedTextCn}}</text>
          </view>
        </view>
      </view>
    </view>

    <view id="chat-bottom-anchor" style="height: 20rpx;"></view>
  </scroll-view>

  <!-- 底部双语输入与回复操作面板 -->
  <view class="bottom-panel">
    <!-- 双语实时翻译对照预览条 -->
    <view class="trans-preview" wx:if="{{translatedText}}">
      <view class="trans-header">
        <text class="trans-title">🌐 即将发送给买家 ({{targetLangName}}):</text>
        <text class="trans-tip">已自动转译</text>
      </view>
      <view class="trans-body">{{translatedText}}</view>
    </view>

    <!-- 售前咨询已回复锁定条 (严格遵循官方单次回复规则) -->
    <view class="answered-lock-bar" wx:if="{{chatType === 'question' && (itemData.has_answer || replied)}}">
      <text class="lock-icon">🔒</text>
      <text class="lock-text">美客多官方规则：该售前咨询已成功回复完成，不支持多次追评</text>
    </view>

    <!-- 输入与发送框 -->
    <view class="input-bar" wx:else>
      <textarea
        class="reply-input"
        placeholder="输入中文回复买家，自动双语翻译..."
        value="{{inputCn}}"
        bindinput="onInputCn"
        maxlength="500"
        auto-height
      />
      <button class="send-btn {{canSend ? 'active' : ''}}" bindtap="sendReplyAction">发 送</button>
    </view>
  </view>
</view>
