page {
  height: 100%;
  background: #171B19;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #171B19;
}

/* 顶部商品卡片 */
.context-card {
  display: flex;
  background: #1C231F;
  border-bottom: 1rpx solid #4E472F;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  align-items: center;
}

.context-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: #202820;
  border: 1rpx solid #4E472F;
  flex-shrink: 0;
}

.context-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.context-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.store-tag {
  background: #203A2B;
  color: #4CAF50;
  border: 1rpx solid #2F6B3F;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.site-tag {
  background: #2D2619;
  color: #D4AF37;
  border: 1rpx solid #6E5D2A;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.item-id {
  font-size: 20rpx;
  font-family: monospace;
  color: #777266;
}

.context-title {
  font-size: 26rpx;
  color: #E6E2D8;
  line-height: 1.3;
}

/* 消息流区域 */
.chat-scroll {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.chat-bubble {
  max-width: 85%;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.buyer-bubble {
  background: #202820;
  border: 1rpx solid #4E472F;
  align-self: flex-start;
  border-left: 6rpx solid #D4AF37;
}

.seller-bubble {
  background: #1C3325;
  border: 1rpx solid #2F6B3F;
  align-self: flex-end;
  margin-left: auto;
  border-right: 6rpx solid #4CAF50;
}

.bubble-header {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.sender-name {
  font-weight: 500;
  color: #D4AF37;
}

.seller-bubble .sender-name {
  color: #81C784;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.4;
  color: #F6F3EA;
}

.es-text {
  font-weight: 500;
}

.bubble-translation {
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #3D4A3F;
  font-size: 24rpx;
  color: #C8C3B7;
}

.trans-tag {
  color: #4CAF50;
  font-weight: 500;
}

.sent-success-tip {
  text-align: center;
  font-size: 24rpx;
  color: #4CAF50;
  margin: 16rpx 0;
  font-weight: 500;
}

/* 索赔专区 */
.claim-alert-card {
  background: #2D1717;
  border: 1rpx solid #6B2323;
  border-left: 8rpx solid #E53E3E;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.claim-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #EF5350;
  margin-bottom: 16rpx;
}

.claim-detail-row {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.claim-detail-row .k {
  width: 150rpx;
  color: #C8C3B7;
}

.claim-detail-row .v {
  flex: 1;
  color: #F6F3EA;
}

.claim-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 16rpx 0;
}

.refund-btn {
  background: #C62828;
  border: 1rpx solid #EF5350;
  color: #FFF;
}

/* 底部操作面板 */
.bottom-panel {
  background: #1C231F;
  border-top: 1rpx solid #4E472F;
  padding: 16rpx 20rpx 30rpx 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.4);
}

.trans-preview {
  background: #192B1E;
  border: 1rpx solid #2F6B3F;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
}

.trans-header {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #81C784;
  margin-bottom: 6rpx;
}

.trans-body {
  font-size: 26rpx;
  color: #C8E6C9;
  font-weight: 500;
  line-height: 1.3;
}

.quick-toolbar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.quick-btn {
  background: #18201C;
  color: #D4AF37;
  border: 1rpx solid #4E472F;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
}

.quick-btn:active {
  background: #253329;
}

.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.reply-input {
  flex: 1;
  background: #18201C;
  color: #F6F3EA;
  border: 1rpx solid #4E472F;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  min-height: 72rpx;
  max-height: 160rpx;
  box-sizing: border-box;
}

.send-btn {
  background: #334036;
  color: #777266;
  font-size: 28rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-weight: 600;
  margin: 0;
  flex-shrink: 0;
  border: 1rpx solid #4E472F;
}

.send-btn.active {
  background: #2F6B3F;
  color: #F6F3EA;
  border-color: #6E5D2A;
}

/* 常用话术抽屉 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.drawer-content {
  background: #1C231F;
  border-top: 1rpx solid #6E5D2A;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  max-height: 70vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #F6F3EA;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #2F3B32;
}

.close-btn {
  font-size: 36rpx;
  color: #C8C3B7;
  padding: 0 10rpx;
}

.drawer-scroll {
  max-height: 55vh;
  margin-top: 16rpx;
}

.category-group {
  margin-bottom: 24rpx;
}

.category-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #D4AF37;
  margin-bottom: 12rpx;
}

.template-item {
  background: #202820;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #4E472F;
}

.template-item:active {
  background: #2A362B;
  border-color: #8A7432;
}

.tpl-cn {
  font-size: 26rpx;
  color: #F6F3EA;
  margin-bottom: 6rpx;
}

.tpl-es {
  font-size: 22rpx;
  color: #C8C3B7;
}
