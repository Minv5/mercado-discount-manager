page {
  height: 100%;
  background: #171B19;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #171B19;
}

/* 顶部商品卡片 */
.context-card {
  display: flex;
  background: #1C231F;
  border-bottom: 1rpx solid #4E472F;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  align-items: center;
}

.context-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: #202820;
  border: 1rpx solid #4E472F;
  flex-shrink: 0;
}

.context-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.context-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.store-tag {
  background: #203A2B;
  color: #4CAF50;
  border: 1rpx solid #2F6B3F;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.site-tag {
  background: #2D2619;
  color: #D4AF37;
  border: 1rpx solid #6E5D2A;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.item-id {
  font-size: 20rpx;
  font-family: monospace;
  color: #777266;
}

.context-title {
  font-size: 26rpx;
  color: #E6E2D8;
  line-height: 1.3;
}

/* 消息流区域 */
.chat-scroll {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.chat-bubble {
  max-width: 85%;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.buyer-bubble {
  background: #202820;
  border: 1rpx solid #4E472F;
  align-self: flex-start;
  border-left: 6rpx solid #D4AF37;
}

.seller-bubble {
  background: #1C3325;
  border: 1rpx solid #2F6B3F;
  align-self: flex-end;
  margin-left: auto;
  border-right: 6rpx solid #4CAF50;
}

.bubble-header {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.sender-name {
  font-weight: 500;
  color: #D4AF37;
}

.seller-bubble .sender-name {
  color: #81C784;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.4;
  color: #F6F3EA;
}

.es-text {
  font-weight: 500;
}

.bubble-translation {
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #3D4A3F;
  font-size: 24rpx;
  color: #C8C3B7;
}

.trans-tag {
  color: #4CAF50;
  font-weight: 500;
}

.sent-success-tip {
  text-align: center;
  font-size: 24rpx;
  color: #4CAF50;
  margin: 16rpx 0;
  font-weight: 500;
}

/* 索赔专区 - 统一黑金质感卡片 */
.claim-alert-card {
  background: #1C231F;
  border: 1rpx solid #36423A;
  border-left: 6rpx solid #D4AF37;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.claim-alert-card.affects-rep {
  border-left: 6rpx solid #EF5350;
  background: #231C1C;
}

.claim-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #F6F3EA;
  margin-bottom: 16rpx;
}

.claim-detail-row {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.claim-detail-row .k {
  width: 150rpx;
  color: #C8C3B7;
}

.claim-detail-row .v {
  flex: 1;
  color: #F6F3EA;
}

/* 底部操作面板 - 完美适配全面屏 Home Indicator 安全区 */
.bottom-panel {
  background: #1C231F;
  border-top: 1rpx solid #4E472F;
  padding: 16rpx 20rpx calc(24rpx + env(safe-area-inset-bottom)) 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.4);
}

.trans-preview {
  background: #192B1E;
  border: 1rpx solid #2F6B3F;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 14rpx;
}

.trans-header {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #81C784;
  margin-bottom: 6rpx;
}

.trans-body {
  font-size: 26rpx;
  color: #C8E6C9;
  font-weight: 500;
  line-height: 1.4;
}

.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.reply-input {
  flex: 1;
  background: #18201C;
  color: #F6F3EA;
  border: 1rpx solid #4E472F;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  min-height: 96rpx;
  max-height: 220rpx;
  box-sizing: border-box;
}

.send-btn {
  background: #334036;
  color: #777266;
  font-size: 28rpx;
  padding: 0 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-weight: 600;
  margin: 0;
  flex-shrink: 0;
  border: 1rpx solid #4E472F;
}

/* 售前咨询已结案锁定提示条 */
.answered-lock-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #18241C;
  border: 1rpx solid #2F6B3F;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
}

.lock-icon {
  font-size: 28rpx;
}

.lock-text {
  font-size: 24rpx;
  color: #81C784;
  font-weight: 500;
}

/* 索赔标题与状态胶囊 */
.claim-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.claim-status-pill {
  font-size: 22rpx;
  background: #252D28;
  color: #D4AF37;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #4E472F;
}

.claim-chat-section {
  margin-top: 30rpx;
}

.section-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.divider-text {
  font-size: 24rpx;
  color: #D4AF37;
  font-weight: 500;
  background: #18201C;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid #4E472F;
}

.mediator-bubble {
  background: #232215;
  border: 1rpx solid #6E5D2A;
  margin-right: 40rpx;
}

.claim-timeline-card {
  background: #18201C;
  border: 1rpx solid #334036;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.timeline-title {
  font-size: 26rpx;
  color: #D4AF37;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.timeline-step {
  display: flex;
  position: relative;
  padding-bottom: 24rpx;
}

.timeline-step:last-child {
  padding-bottom: 0;
}

.timeline-step::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: #334036;
}

.timeline-step:last-child::before {
  display: none;
}

.step-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #2A362D;
  border: 2rpx solid #4E472F;
  margin-right: 18rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.step-dot.active {
  background: #4CAF50;
  border-color: #81C784;
  box-shadow: 0 0 10rpx rgba(76, 175, 80, 0.4);
}

.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.step-name {
  font-size: 26rpx;
  color: #F6F3EA;
  font-weight: 500;
}

.step-desc {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.send-btn.active {
  background: #2F6B3F;
  color: #F6F3EA;
  border-color: #6E5D2A;
}


