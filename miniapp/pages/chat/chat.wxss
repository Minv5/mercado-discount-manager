page {
  height: 100%;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F4F6F9;
}

/* 顶部商品卡片 */
.context-card {
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #E5E5E5;
  gap: 16rpx;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.context-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: #EEE;
  flex-shrink: 0;
}

.context-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.context-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.store-tag {
  background: #E8EAF6;
  color: #283593;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.site-tag {
  background: #FFF8E1;
  color: #F57F17;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.item-id {
  font-size: 20rpx;
  font-family: monospace;
}

.context-title {
  font-size: 26rpx;
  color: #333;
  line-height: 1.3;
}

/* 消息流区域 */
.chat-scroll {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.chat-bubble {
  max-width: 85%;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.buyer-bubble {
  background: #FFFFFF;
  align-self: flex-start;
  border-left: 6rpx solid #1976D2;
}

.seller-bubble {
  background: #E3F2FD;
  align-self: flex-end;
  margin-left: auto;
  border-right: 6rpx solid #1565C0;
}

.bubble-header {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.sender-name {
  font-weight: 500;
  color: #424242;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.4;
  color: #212121;
}

.es-text {
  font-weight: 500;
}

.bubble-translation {
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #DDD;
  font-size: 24rpx;
  color: #555;
}

.trans-tag {
  color: #2E7D32;
  font-weight: 500;
}

.sent-success-tip {
  text-align: center;
  font-size: 24rpx;
  color: #2E7D32;
  margin: 16rpx 0;
  font-weight: 500;
}

/* 索赔专区 */
.claim-alert-card {
  background: #FFF;
  border-left: 8rpx solid #D32F2F;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.claim-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #D32F2F;
  margin-bottom: 16rpx;
}

.claim-detail-row {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.claim-detail-row .k {
  width: 150rpx;
  color: #757575;
}

.claim-detail-row .v {
  flex: 1;
  color: #212121;
}

.claim-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 16rpx 0;
}

.refund-btn {
  background: #D32F2F;
  color: #FFF;
}

/* 底部操作面板 */
.bottom-panel {
  background: #FFFFFF;
  border-top: 1rpx solid #E0E0E0;
  padding: 16rpx 20rpx 30rpx 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.03);
}

.trans-preview {
  background: #F1F8E9;
  border: 1rpx solid #C5E1A5;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
}

.trans-header {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #33691E;
  margin-bottom: 6rpx;
}

.trans-body {
  font-size: 26rpx;
  color: #1B5E20;
  font-weight: 500;
  line-height: 1.3;
}

.quick-toolbar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.quick-btn {
  background: #F5F5F5;
  color: #424242;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  border: 1rpx solid #E0E0E0;
}

.quick-btn:active {
  background: #E0E0E0;
}

.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.reply-input {
  flex: 1;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  min-height: 72rpx;
  max-height: 160rpx;
  box-sizing: border-box;
}

.send-btn {
  background: #B0BEC5;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-weight: 500;
  margin: 0;
  flex-shrink: 0;
}

.send-btn.active {
  background: #1976D2;
}

/* 常用话术抽屉 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.drawer-content {
  background: #FFFFFF;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  max-height: 70vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EEE;
}

.close-btn {
  font-size: 36rpx;
  color: #999;
  padding: 0 10rpx;
}

.drawer-scroll {
  max-height: 55vh;
  margin-top: 16rpx;
}

.category-group {
  margin-bottom: 24rpx;
}

.category-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #1976D2;
  margin-bottom: 12rpx;
}

.template-item {
  background: #FAFAFA;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #EEE;
}

.template-item:active {
  background: #E3F2FD;
}

.tpl-cn {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.tpl-es {
  font-size: 22rpx;
  color: #757575;
}
