<view class="container">
  <!-- 顶部分类标签导航 (1:1 严格对齐桌面端 Tab 顺序与文案) -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 0 ? 'active' : ''}}" bindtap="onTabChange" data-tab="0">
      <text class="tab-title">售前咨询{{pendingQuestionsCount > 0 ? ' (' + pendingQuestionsCount + '待回复)' : ''}}</text>
    </view>
    <view class="tab-item {{activeTab === 1 ? 'active' : ''}}" bindtap="onTabChange" data-tab="1">
      <text class="tab-title">订单索赔{{pendingClaimsCount > 0 ? ' (' + pendingClaimsCount + '进行中)' : ''}}</text>
    </view>
    <view class="tab-item {{activeTab === 2 ? 'active' : ''}}" bindtap="onTabChange" data-tab="2">
      <text class="tab-title">售后私信{{unreadMessagesCount > 0 ? ' (' + unreadMessagesCount + '未读)' : ''}}</text>
    </view>
  </view>

  <!-- 列表内容区 -->
  <view class="list-container">
    <!-- 1. 售前咨询列表 (QA) -->
    <block wx:if="{{activeTab === 0}}">
      <view class="desktop-card" wx:for="{{questions}}" wx:key="id" bindtap="openChat" data-type="question" data-id="{{item.id}}" data-item="{{item}}">
        <image class="item-thumb" src="{{item.item_thumbnail || '/images/default_product.png'}}" mode="aspectFill" />
        <view class="item-content">
          <view class="row-top">
            <view class="store-tags">
              <text class="store-badge">{{item.store_name}}</text>
              <text class="site-tag">{{item.site_id}}</text>
            </view>
            <text class="time-text">{{item.created_at}}</text>
          </view>

          <view class="row-mid">
            <text class="buyer-name">{{item.buyer_name}}</text>
            <view class="badge-group">
              <text class="badge-status {{item.status_class}}">{{item.status_text}}</text>
            </view>
          </view>

          <view class="row-bottom">
            <text class="bottom-snip ellipsis-1" user-select="true" selectable="true">问: {{item.text_cn || item.text_es}}</text>
          </view>
        </view>
      </view>

      <view class="list-summary" wx:if="{{!isLoading && questions.length > 0}}">共 {{questions.length}} 条提问</view>

      <view class="empty-state" wx:if="{{!isLoading && questions.length === 0}}">
        <text class="empty-icon">🎉</text>
        <text class="empty-text">当前没有待回复的售前咨询</text>
      </view>
    </block>

    <!-- 2. 订单索赔列表 (Claims，全量 70 笔，1:1 严格对齐桌面端) -->
    <block wx:if="{{activeTab === 1}}">
      <view class="desktop-card" wx:for="{{claims}}" wx:key="id" bindtap="openChat" data-type="claim" data-id="{{item.id}}" data-item="{{item}}">
        <image class="item-thumb" src="{{item.item_thumbnail || '/images/default_product.png'}}" mode="aspectFill" />
        <view class="item-content">
          <view class="row-top">
            <view class="store-tags">
              <text class="store-badge">{{item.store_name}}</text>
              <text class="site-tag">{{item.site_id}}</text>
              <text class="order-mono" wx:if="{{item.order_id}}">#{{item.order_id}}</text>
            </view>
            <text class="time-text">{{item.created_at}}</text>
          </view>

          <view class="row-mid">
            <text class="buyer-name">{{item.buyer_name}}</text>
            <view class="badge-group">
              <text class="badge-rep {{item.rep_badge_class}}">{{item.rep_badge_text}}</text>
              <text class="badge-status {{item.status_class}}">{{item.status_text}}</text>
            </view>
          </view>

          <view class="row-bottom">
            <text class="bottom-snip ellipsis-1" user-select="true" selectable="true">理由: {{item.reason_display}}</text>
          </view>
        </view>
      </view>

      <view class="list-summary" wx:if="{{!isLoading && claims.length > 0}}">共 {{claims.length}} 笔索赔</view>

      <view class="empty-state" wx:if="{{!isLoading && claims.length === 0}}">
        <text class="empty-icon">🛡️</text>
        <text class="empty-text">当前没有进行中的订单索赔</text>
      </view>
    </block>

    <!-- 3. 售后私信列表 (Messages，1:1 严格对齐桌面端) -->
    <block wx:if="{{activeTab === 2}}">
      <view class="desktop-card" wx:for="{{messages}}" wx:key="id" bindtap="openChat" data-type="message" data-id="{{item.id}}" data-item="{{item}}">
        <image class="item-thumb" src="{{item.item_thumbnail || '/images/default_product.png'}}" mode="aspectFill" />
        <view class="item-content">
          <view class="row-top">
            <view class="store-tags">
              <text class="store-badge">{{item.store_name}}</text>
              <text class="site-tag">{{item.site_id}}</text>
              <text class="order-mono" wx:if="{{item.order_id}}">#{{item.order_id}}</text>
            </view>
            <text class="time-text">{{item.created_at}}</text>
          </view>

          <view class="row-mid">
            <text class="buyer-name">{{item.buyer_name}}</text>
            <view class="badge-group">
              <text class="badge-status {{item.status_class}}">{{item.status_text}}</text>
            </view>
          </view>

          <view class="row-bottom">
            <text class="bottom-snip ellipsis-1" user-select="true" selectable="true">{{item.item_title || item.last_message}}</text>
          </view>
        </view>
      </view>

      <view class="list-summary" wx:if="{{!isLoading && messages.length > 0}}">共 {{messages.length}} 条私信</view>

      <view class="empty-state" wx:if="{{!isLoading && messages.length === 0}}">
        <text class="empty-icon">✅</text>
        <text class="empty-text">当前没有待处理的售后私信</text>
      </view>
    </block>

    <!-- 加载中动画骨架 -->
    <view class="loading-state" wx:if="{{isLoading && ((activeTab === 0 && questions.length === 0) || (activeTab === 1 && claims.length === 0) || (activeTab === 2 && messages.length === 0))}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在同步美客多官方数据...</text>
    </view>
  </view>
</view>
