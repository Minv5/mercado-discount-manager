/* 顶部选项卡 */
.tab-bar {
  display: flex;
  background: #1C231F;
  border: 1rpx solid #4E472F;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #C8C3B7;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #2F6B3F;
  color: #F6F3EA;
  font-weight: bold;
  border: 1rpx solid #6E5D2A;
}

.tab-badge {
  background: #D32F2F;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}

.badge-red-bg {
  background: #C62828;
}

/* 列表卡片 */
.item-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s ease;
}

.item-card:active {
  background: #253026;
}

.claim-border {
  border-left: 6rpx solid #E53E3E;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.store-badge {
  background: #203A2B;
  color: #4CAF50;
  border: 1rpx solid #2F6B3F;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.site-tag {
  background: #2D2619;
  color: #D4AF37;
  border: 1rpx solid #6E5D2A;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.order-tag {
  font-size: 22rpx;
  color: #C8C3B7;
  font-family: monospace;
}

.time-text {
  font-size: 22rpx;
  color: #777266;
}

/* 商品摘要 */
.product-snippet {
  display: flex;
  gap: 16rpx;
  background: #18201C;
  border: 1rpx solid #2F3B32;
  padding: 12rpx;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
}

.thumb {
  width: 90rpx;
  height: 90rpx;
  border-radius: 8rpx;
  background: #2D3A30;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-title {
  font-size: 26rpx;
  color: #E6E2D8;
  line-height: 1.3;
}

.item-id-tag {
  font-size: 20rpx;
  color: #777266;
  font-family: monospace;
}

/* 提问内容框 */
.question-box {
  background: #232219;
  border-left: 4rpx solid #D4AF37;
  padding: 14rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.q-lang-es {
  font-size: 28rpx;
  color: #F6F3EA;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.q-prefix {
  color: #D4AF37;
}

.q-lang-cn {
  font-size: 24rpx;
  color: #C8C3B7;
  border-top: 1rpx dashed #3D3728;
  padding-top: 8rpx;
}

.cn-label {
  color: #4CAF50;
  font-weight: 500;
}

/* 售后私信样式 */
.buyer-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.buyer-name-strong {
  font-size: 28rpx;
  font-weight: bold;
  color: #F6F3EA;
}

.unread-dot {
  background: #E53E3E;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}

.last-msg-box {
  background: #18231C;
  border: 1rpx solid #2B3A30;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
}

.msg-es {
  display: block;
  font-size: 28rpx;
  color: #E6E2D8;
}

.msg-cn {
  display: block;
  font-size: 24rpx;
  color: #777266;
  margin-top: 4rpx;
}

/* 索赔专区 */
.countdown-badge {
  background: #381A1A;
  color: #EF5350;
  border: 1rpx solid #C62828;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

.claim-body {
  margin-bottom: 16rpx;
}

.claim-row {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 6rpx;
}

.claim-label {
  color: #C8C3B7;
  width: 150rpx;
}

.claim-value {
  color: #E6E2D8;
}

.mono {
  font-family: monospace;
}

.claim-reason-box {
  background: #2D1717;
  border: 1rpx solid #5C2323;
  padding: 12rpx;
  border-radius: 8rpx;
  color: #EF5350;
  font-size: 26rpx;
  margin-top: 10rpx;
}

/* 卡片底栏 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #2B352E;
  padding-top: 16rpx;
}

.btn-reply {
  background: #2F6B3F;
  color: #F6F3EA;
  border: 1rpx solid #4E472F;
  font-size: 24rpx;
  font-weight: 500;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.btn-blue {
  background: #1C3345;
  border-color: #2F597A;
  color: #64B5F6;
}

.btn-red {
  background: #3A1A1A;
  border-color: #8C2F2F;
  color: #EF5350;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #777266;
}
