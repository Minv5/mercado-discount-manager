/* 顶部分类标签导航 (1:1 对齐桌面端三段式 Tab) */
.tab-bar {
  display: flex;
  background: #141A16;
  border: 1rpx solid #332B1C;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  gap: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #A8A29E;
  background: #1C231F;
  border: 1rpx solid #4E472F;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #203A2B;
  border: 1rpx solid #3E7B4B;
  color: #FFFFFF;
  font-weight: bold;
}

.tab-title {
  white-space: nowrap;
}

/* 列表容器 */
.list-container {
  padding-bottom: 30rpx;
}

/* 桌面端 1:1 复刻单行条目卡片 */
.desktop-card {
  display: flex;
  align-items: center;
  background: #18201C;
  border: 1rpx solid #2B352E;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
  gap: 18rpx;
  transition: all 0.15s ease;
}

.desktop-card:active {
  background: #222C26;
  border-color: #3E7B4B;
}

/* 左侧商品主图缩略图 (44x44 对齐桌面端) */
.item-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 10rpx;
  background: #232C25;
  border: 1rpx solid #38453B;
  flex-shrink: 0;
}

/* 右侧内容排版 (三行流式布局) */
.item-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

/* 第一行：店铺、站点、订单号与时间 */
.row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: nowrap;
}

.store-badge {
  color: #4CAF50;
  font-size: 20rpx;
  font-weight: 600;
}

.site-tag {
  color: #D4AF37;
  font-size: 20rpx;
  font-weight: 600;
}

.order-mono {
  font-family: monospace;
  font-size: 20rpx;
  color: #777266;
}

.time-text {
  font-size: 20rpx;
  color: #777266;
  font-family: monospace;
}

/* 第二行：买家姓名与状态徽章组 */
.row-mid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.buyer-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #F6F3EA;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 320rpx;
}

.badge-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

/* 通用徽章胶囊 */
.badge-pill {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 500;
  line-height: 1.2;
}

/* 信誉影响徽章 (严格对齐桌面端 CARD_STYLE_GREEN / CARD_STYLE_RED) */
.badge-rep-green {
  background: #152E20;
  border: 1rpx solid #2E7D32;
  color: #34D399;
}

.badge-rep-red {
  background: #331515;
  border: 1rpx solid #B71C1C;
  color: #F87171;
}

/* 官方状态徽章 (严格对齐桌面端) */
.badge-status-gold,
.status-gold {
  background: #2D2619;
  border: 1rpx solid #6E5D2A;
  color: #F6C453;
}

.badge-status-blue {
  background: #102A3C;
  border: 1rpx solid #1976D2;
  color: #64B5F6;
}

.badge-status-red {
  background: #331515;
  border: 1rpx solid #B71C1C;
  color: #EF5350;
}

.badge-status-gray,
.status-gray {
  background: #242825;
  border: 1rpx solid #3E4A42;
  color: #9E9E9E;
}

.status-green {
  background: #152E20;
  border: 1rpx solid #2E7D32;
  color: #4CAF50;
}

/* 第三行：底部摘要 (商品英文名 / 投诉理由 / 提问内容) */
.row-bottom {
  display: flex;
  align-items: center;
}

.bottom-snip {
  font-size: 22rpx;
  color: #A8A29E;
  line-height: 1.3;
}

.ellipsis-1 {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 列表底部全量笔数统计 (严格对齐桌面端右下角) */
.list-summary {
  text-align: right;
  padding: 16rpx 10rpx 20rpx 0;
  font-size: 22rpx;
  color: #777266;
  font-family: monospace;
}

/* 旋转骨架屏 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #2B352E;
  border-top-color: #D4AF37;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #A8A29E;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #777266;
}
